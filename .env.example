# ControlPlane.ai environment configuration
# Copy to backend/.env and adjust.

# --- Demo mode: works with no API key and no network (default true) ---
DEMO_MODE=true

# --- LLM provider abstraction (openai = any OpenAI-compatible API) ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
# Optional custom endpoint for OpenAI-compatible providers
LLM_BASE_URL=

# --- Database (SQLAlchemy URL; SQLite default, PostgreSQL-compatible) ---
DATABASE_URL=

# --- Server ---
CORS_ORIGINS=http://localhost:3000
